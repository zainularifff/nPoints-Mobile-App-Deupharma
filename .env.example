# Copy this file to .env and set the real backend URL for your environment.
# .env is gitignored — never commit a real server address here.
#
# - Local dev on a physical device via Expo Go: use your dev PC's LAN IP,
#   not localhost (a phone can't resolve that to your PC).
# - Preview/production builds: set via `eas secret:create` / eas.json env,
#   not this file.
API_URL=http://<your-backend-host>:3001
